{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zpkg.tech/schemas/client-api.schema.json",
  "title": "Zed polyglot client API surface",
  "description": "Canonical public/private API declaration shared by every generated client runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "symbols"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "package": {"$ref": "#/$defs/package"},
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/symbol"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "private"]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate", "namespace"],
      "properties": {
        "coordinate": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "namespace": {"$ref": "#/$defs/identifier"},
        "description": {"type": "string"}
      }
    },
    "typeRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {"const": "primitive"},
            "name": {
              "type": "string",
              "enum": ["string", "boolean", "integer", "number", "bytes", "void", "unknown"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {"const": "named"},
            "name": {"$ref": "#/$defs/identifier"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "item"],
          "properties": {
            "kind": {"enum": ["array", "optional"]},
            "item": {"$ref": "#/$defs/typeRef"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key", "value"],
          "properties": {
            "kind": {"const": "map"},
            "key": {"$ref": "#/$defs/typeRef"},
            "value": {"$ref": "#/$defs/typeRef"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "items"],
          "properties": {
            "kind": {"const": "union"},
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {"$ref": "#/$defs/typeRef"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "arguments"],
          "properties": {
            "kind": {"const": "generic"},
            "name": {"$ref": "#/$defs/identifier"},
            "arguments": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/typeRef"}
            }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "type": {"$ref": "#/$defs/typeRef"},
        "description": {"type": "string"},
        "default": {}
      }
    },
    "callable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "visibility", "parameters", "returns", "async"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "visibility": {"$ref": "#/$defs/visibility"},
        "description": {"type": "string"},
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/$defs/parameter"}
        },
        "returns": {"$ref": "#/$defs/typeRef"},
        "async": {"type": "boolean"},
        "static": {"type": "boolean", "default": false},
        "throws": {
          "type": "array",
          "items": {"$ref": "#/$defs/typeRef"}
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "visibility", "type"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "visibility": {"$ref": "#/$defs/visibility"},
        "type": {"$ref": "#/$defs/typeRef"},
        "readonly": {"type": "boolean", "default": false},
        "description": {"type": "string"}
      }
    },
    "classSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "visibility", "fields", "constructors", "methods"],
      "properties": {
        "kind": {"const": "class"},
        "name": {"$ref": "#/$defs/identifier"},
        "visibility": {"$ref": "#/$defs/visibility"},
        "description": {"type": "string"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "constructors": {"type": "array", "items": {"$ref": "#/$defs/callable"}},
        "methods": {"type": "array", "items": {"$ref": "#/$defs/callable"}},
        "implements": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "interfaceSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "visibility", "methods"],
      "properties": {
        "kind": {"const": "interface"},
        "name": {"$ref": "#/$defs/identifier"},
        "visibility": {"$ref": "#/$defs/visibility"},
        "description": {"type": "string"},
        "methods": {"type": "array", "items": {"$ref": "#/$defs/callable"}}
      }
    },
    "functionSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "visibility", "parameters", "returns", "async"],
      "properties": {
        "kind": {"const": "function"},
        "name": {"$ref": "#/$defs/identifier"},
        "visibility": {"$ref": "#/$defs/visibility"},
        "description": {"type": "string"},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
        "returns": {"$ref": "#/$defs/typeRef"},
        "async": {"type": "boolean"},
        "static": {"type": "boolean", "default": false},
        "throws": {"type": "array", "items": {"$ref": "#/$defs/typeRef"}}
      }
    },
    "typeSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "visibility", "definition"],
      "properties": {
        "kind": {"const": "type"},
        "name": {"$ref": "#/$defs/identifier"},
        "visibility": {"$ref": "#/$defs/visibility"},
        "description": {"type": "string"},
        "definition": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "fields"],
              "properties": {
                "kind": {"const": "object"},
                "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "target"],
              "properties": {
                "kind": {"const": "alias"},
                "target": {"$ref": "#/$defs/typeRef"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "values"],
              "properties": {
                "kind": {"const": "enum"},
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"$ref": "#/$defs/identifier"}
                }
              }
            }
          ]
        }
      }
    },
    "symbol": {
      "oneOf": [
        {"$ref": "#/$defs/classSymbol"},
        {"$ref": "#/$defs/interfaceSymbol"},
        {"$ref": "#/$defs/functionSymbol"},
        {"$ref": "#/$defs/typeSymbol"}
      ]
    }
  }
}
