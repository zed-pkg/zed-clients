            },
            "name": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "item": {
              "$ref": "#/$defs/typeRef"
            },
            "kind": {
              "enum": [
                "array",
