              },
              "required": [
                "kind",
                "values"
              ],
              "type": "object"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "const": "type"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        }
      },
      "required": [
        "kind",
        "name",
        "visibility",
        "definition"
      ],
      "type": "object"
