  "$id": "https://zpkg.tech/schemas/client-api.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical public/private API declaration shared by every generated client runtime.",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "schemaVersion": {
      "const": 1
    },
    "symbols": {
      "items": {
        "$ref": "#/$defs/symbol"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "package",
    "symbols"
  ],
  "title": "Zed polyglot client API surface",
  "type": "object"
}
