        },
        {
          "additionalProperties": false,
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/typeRef"
              },
              "minItems": 2,
              "type": "array"
            },
            "kind": {
              "const": "union"
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "arguments": {
              "items": {
                "$ref": "#/$defs/typeRef"
              },
              "minItems": 1,
              "type": "array"
            },
            "kind": {
              "const": "generic"
            },
            "name": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "kind",
            "name",
            "arguments"
          ],
          "type": "object"
        }
      ]
