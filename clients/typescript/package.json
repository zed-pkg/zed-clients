{
  "name": "@zed-pkg/client",
  "version": "0.1.0",
  "description": "TypeScript SDK for the zed-pkg registry (zero runtime deps)",
  "license": "MIT",
  "repository": "github:zed-pkg/zed-clients",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nodejs": {
      "types": "./dist/runtimes/nodejs/index.d.ts",
      "default": "./dist/runtimes/nodejs/index.js"
    },
    "./deno": {
      "types": "./dist/runtimes/deno/index.d.ts",
      "default": "./dist/runtimes/deno/index.js"
    },
    "./bun": {
      "types": "./dist/runtimes/bun/index.d.ts",
      "default": "./dist/runtimes/bun/index.js"
    },
    "./edge": {
      "types": "./dist/runtimes/edge/index.d.ts",
      "default": "./dist/runtimes/edge/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "node --test test/*.test.mjs",
    "lint:ores": "if [ -f ../../.ores-lint/lint.sh ]; then sh ../../.ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores",
    "prebuild": "npm run lint:ores"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
