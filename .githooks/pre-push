#!/usr/bin/env bash
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"
if [[ "${1:-}" == "--install" ]]; then chmod +x .githooks/pre-push; git config core.hooksPath .githooks; echo 'installed Zed pre-push hook'; exit 0; fi
[[ -f .zpkg.toml ]] || exit 0
command -v zed >/dev/null 2>&1 || { echo 'zed CLI is required' >&2; exit 1; }
[[ -f .zpkg.lock ]] || { echo '.zpkg.lock is required for this dependency-bearing package; run zed install and commit resolver output' >&2; exit 1; }

# Resolve first. A tracked but stale/incomplete lock must be allowed to become
# concrete resolver output so CI can report the exact provenance delta instead
# of failing before resolution. The gate still fails unless the committed lock
# is byte-for-byte current after resolution.
zed install
if ! git diff --quiet HEAD -- .zpkg.lock; then
  echo 'Zed dependency lock differs from resolver output; commit the generated immutable provenance before merge.' >&2
  git --no-pager diff HEAD -- .zpkg.lock >&2 || true
  exit 1
fi
zed validate --require-lock
zed install --frozen
zed build
if [[ -f Cargo.toml ]]; then if [[ -f Cargo.lock ]]; then zed develop --no-install -c 'cargo check --locked --all-targets'; else zed develop --no-install -c 'cargo check --all-targets'; fi; fi
if [[ -f go.mod ]]; then zed develop --no-install -c 'go test ./...'; fi
if [[ -f package.json ]]; then
  if [[ -f pnpm-lock.yaml ]]; then pm='corepack pnpm'; install_cmd='corepack pnpm install --frozen-lockfile'; elif [[ -f package-lock.json ]]; then pm='npm'; install_cmd='npm ci'; elif [[ -f yarn.lock ]]; then pm='corepack yarn'; install_cmd='corepack yarn install --immutable'; else pm='npm'; install_cmd='npm install --ignore-scripts'; fi
  if node -e 'const p=require("./package.json"); process.exit(p.scripts && p.scripts.typecheck ? 0 : 1)'; then script=typecheck; elif node -e 'const p=require("./package.json"); process.exit(p.scripts && p.scripts.build ? 0 : 1)'; then script=build; else echo 'package.json has neither typecheck nor build; refusing fake compile coverage' >&2; exit 1; fi
  zed develop --no-install -c "$install_cmd && $pm run $script"
fi
if [[ -f pyproject.toml || -f setup.py ]]; then zed develop --no-install -c 'python3 -m compileall -q .'; fi
if [[ -f pom.xml ]]; then zed develop --no-install -c 'mvn -B -DskipTests compile'; fi
if [[ -f gradlew ]]; then zed develop --no-install -c './gradlew --no-daemon classes'; fi
pack_dir="${TMPDIR:-/tmp}/zed-latest-deps-pack-$$"; trap 'rm -rf "$pack_dir"' EXIT; mkdir -p "$pack_dir"; zed pack --out "$pack_dir"
