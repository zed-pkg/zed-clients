{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/clients/client-surface.v1.schema.json",
  "title": "ORES polyglot client exported-surface contract",
  "type": "object",
  "required": ["contractVersion", "product", "operations"],
  "properties": {
    "$schema": { "type": "string" },
    "contractVersion": { "type": "string", "minLength": 1 },
    "product": { "type": "string", "minLength": 1 },
    "provenance": { "type": "object", "additionalProperties": true },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
          "doc": { "type": "string" },
          "async": { "type": "boolean", "default": false },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean", "default": false },
                "$ref": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "returns": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "$ref": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
